{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "paths": {
      "@styles/*": [
        "./src/styles/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@consts": [
        "./src/consts"
      ],
      "@types": [
        "./src/types"
      ],
      "@i18n/*": [
        "./src/i18n/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}