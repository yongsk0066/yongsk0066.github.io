{
  "name": "yongseok_blog",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "start": "pnpm dev",
    "build": "pnpm playground:prepare && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:seo": "node --test scripts/seo.test.mjs",
    "new:post": "node scripts/create-post.js",
    "cf:dev": "pnpm build && wrangler dev",
    "cf:deploy": "pnpm media:prepare && pnpm media:publish && pnpm build && wrangler deploy",
    "cf:preview": "wrangler dev",
    "playground:prepare": "node scripts/reploom/prepare.mjs",
    "playground:bootstrap": "node scripts/reploom/bootstrap.mjs",
    "test:playground": "playwright test --config tests/reploom/playwright.config.ts",
    "test:playground:modules": "node --test tests/reploom/*.test.mjs",
    "check:playground": "tsc --project tests/reploom/tsconfig.json",
    "media:prepare": "node scripts/media/publish.mjs prepare",
    "media:stage": "node scripts/media/publish.mjs stage",
    "media:publish": "node scripts/media/publish.mjs publish",
    "media:restore": "node scripts/media/publish.mjs restore"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "7.1.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.5",
    "@lit/task": "^1.0.3",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.12",
    "clsx": "^2.1.1",
    "lit": "^3.3.3",
    "mermaid": "^12.3.0",
    "meshline": "^3.3.1",
    "motion": "^14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "@yongsk0066/reploom": "file:.reploom/packages/yongsk0066-reploom-0.1.0-alpha.0.tgz",
    "@yongsk0066/reploom-ui": "file:.reploom/packages/yongsk0066-reploom-ui-0.1.0-alpha.0.tgz",
    "aws4fetch": "1.0.20",
    "fast-xml-parser": "5.11.2",
    "parse5": "8.1.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdast": "^4.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "@types/youtube": "^0.3.0",
    "inquirer": "^14.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "7.0.2",
    "wrangler": "^4.164.0",
    "@yongsk0066/reploom-build": "file:.reploom/packages/yongsk0066-reploom-build-0.1.0-alpha.0.tgz",
