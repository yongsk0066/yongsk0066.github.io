#!/bin/sh
set -eu
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$remote_ref" = refs/heads/cloudflare/main ] || continue
  case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
  if git cat-file -e "$remote_oid^{commit}" 2>/dev/null &&
     git diff --quiet "$remote_oid" "$local_oid" -- media/svalbard_3/manifest.json; then continue; fi
  # The published manifest must be the one on the commit actually being pushed.
  if ! git diff --quiet "$local_oid" -- media/svalbard_3/manifest.json; then
    echo "Commit the prepared photo manifest before pushing." >&2
    exit 1
  fi
  pnpm media:stage
done
