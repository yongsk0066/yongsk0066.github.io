{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "../../src/components/article/reploom/**/*.ts",
    "../../src/components/article/reploom/**/*.tsx",
    "../../src/dev/design/**/*.tsx",
    "../../src/dev/design/**/*.ts",
    "./*.ts"
  ]
}
