---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="404" description="페이지를 찾을 수 없습니다">
  <Container>
    <div class="not-found">
      <figure>
        <div class="video-crop">
          <h1>404</h1>
          <iframe
            id="yt-player"
            src="https://www.youtube.com/embed/zhHB4dZTChw?start=32&autoplay=1&mute=1&controls=0&enablejsapi=1&modestbranding=1&rel=0"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            loading="lazy"
            allowfullscreen></iframe>
          <canvas class="ascii-overlay" width="600" height="400"></canvas>
          <div class="controls">
            <button id="btn-play" type="button" aria-label="일시정지">
              <svg
                class="icon-pause"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="20"
                height="20"
              >
                <rect x="6" y="4" width="4" height="16"></rect>
                <rect x="14" y="4" width="4" height="16"></rect>
              </svg>
              <svg
                class="icon-play"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="20"
                height="20"
              >
                <polygon points="6,3 20,12 6,21"></polygon>
              </svg>
            </button>
            <button id="btn-mute" type="button" aria-label="음소거 해제">
              <svg
                class="icon-muted"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="20"
                height="20"
              >
                <polygon points="11,5 6,9 2,9 2,15 6,15 11,19"></polygon>
                <line
                  x1="23"
                  y1="9"
                  x2="17"
                  y2="15"
                  stroke="currentColor"
                  stroke-width="2"></line>
                <line
                  x1="17"
                  y1="9"
                  x2="23"
                  y2="15"
                  stroke="currentColor"
                  stroke-width="2"></line>
              </svg>
              <svg
                class="icon-unmuted"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="20"
                height="20"
              >
                <polygon points="11,5 6,9 2,9 2,15 6,15 11,19"></polygon>
                <path
                  d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"></path>
              </svg>
            </button>
          </div>
        </div>
      </figure>
      <p>페이지를 찾을 수 없습니다.</p>
      <nav>
        <a href="/">홈으로 돌아가기</a>
        <span>·</span>
        <a href="/blog">블로그</a>
      </nav>
    </div>
  </Container>
</PageLayout>

<script>
  const tag = document.createElement("script");
  tag.src = "https://www.youtube.com/iframe_api";
  document.head.appendChild(tag);

  let player: YT.Player;
  const btnPlay = document.getElementById("btn-play")!;
  const btnMute = document.getElementById("btn-mute")!;

  function setPlaying(playing: boolean) {
    btnPlay.querySelector<SVGElement>(".icon-pause")!.style.display = playing
      ? ""
      : "none";
    btnPlay.querySelector<SVGElement>(".icon-play")!.style.display = playing
      ? "none"
      : "";
    btnPlay.setAttribute("aria-label", playing ? "일시정지" : "재생");
  }

  function setMuted(muted: boolean) {
    btnMute.querySelector<SVGElement>(".icon-muted")!.style.display = muted
      ? ""
      : "none";
    btnMute.querySelector<SVGElement>(".icon-unmuted")!.style.display = muted
      ? "none"
      : "";
    btnMute.setAttribute("aria-label", muted ? "음소거 해제" : "음소거");
  }

  // initial state: playing + muted
  setPlaying(true);
  setMuted(true);

  // --- Pre-baked ASCII overlay ---
  const asciiCanvas = document.querySelector<HTMLCanvasElement>(".ascii-overlay")!;
  const ctx = asciiCanvas.getContext("2d")!;
  const asciiImg = new Image();
  asciiImg.src = "/assets/images/ascii.png";

  const BLOCK = 10;
  const GRID = 10;
  const CHAR_PX = 256 / GRID; // 25.6
  const VIDEO_START = 32;

  let asciiData: {
    cols: number;
    rows: number;
    fps: number;
    frameCount: number;
    frames: Uint8Array;
  } | null = null;

  // Load pre-baked data
  fetch("/assets/404-ascii.bin")
    .then((r) => r.arrayBuffer())
    .then((buf) => {
      const v = new DataView(buf);
      asciiData = {
        cols: v.getUint16(0, true),
        rows: v.getUint16(2, true),
        fps: v.getUint16(4, true),
        frameCount: v.getUint16(6, true),
        frames: new Uint8Array(buf, 8),
      };
    });

  let lastFrameIdx = -1;

  function renderAscii() {
    requestAnimationFrame(renderAscii);
    if (!asciiData || !asciiImg.complete || !player) return;

    let currentTime: number;
    try {
      currentTime = player.getCurrentTime();
    } catch {
      return;
    }

    const clipTime = Math.max(0, currentTime - VIDEO_START);
    const frameIdx = Math.floor(clipTime * asciiData.fps) % asciiData.frameCount;
    if (frameIdx === lastFrameIdx) return;
    lastFrameIdx = frameIdx;

    const { cols, rows, frames } = asciiData;
    const bpf = cols * rows * 3; // bytes per frame
    const offset = frameIdx * bpf;
    const w = cols * BLOCK; // 600
    const h = rows * BLOCK; // 400

    // 1. Draw ASCII characters (white on black) based on brightness
    ctx.imageSmoothingEnabled = false;
    ctx.clearRect(0, 0, w, h);

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const i = offset + (r * cols + c) * 3;
        const sr = frames[i],
          sg = frames[i + 1],
          sb = frames[i + 2];
        const lum = (sr + sg + sb) / 765; // 0..1

        // Select character: brightness → column (pow curve from original shader)
        const charCol = Math.min(Math.floor(GRID * lum * lum), GRID - 1);
        // Deterministic row per cell position (like random in shader)
        const charRow = ((r * 7 + c * 13) & 0xff) % GRID;

        ctx.drawImage(
          asciiImg,
          charCol * CHAR_PX,
          charRow * CHAR_PX,
          CHAR_PX,
          CHAR_PX,
          c * BLOCK,
          r * BLOCK,
          BLOCK,
          BLOCK,
        );
      }
    }

    // 2. Post-process: white chars → video color, black bg → dark
    const imgData = ctx.getImageData(0, 0, w, h);
    const d = imgData.data;

    for (let y = 0; y < h; y++) {
      const br = Math.min((y / BLOCK) | 0, rows - 1);
      for (let x = 0; x < w; x++) {
        const bc = Math.min((x / BLOCK) | 0, cols - 1);
        const pi = (y * w + x) * 4;
        const fi = offset + (br * cols + bc) * 3;
        const t = (d[pi] + d[pi + 1] + d[pi + 2]) / 765; // 0=bg, 1=char

        // char → video color, bg → dark semi-transparent
        d[pi] = (frames[fi] * t) | 0;
        d[pi + 1] = (frames[fi + 1] * t) | 0;
        d[pi + 2] = (frames[fi + 2] * t) | 0;
        d[pi + 3] = (227 * (1 - t) + 255 * t) | 0;
      }
    }

    ctx.putImageData(imgData, 0, 0);
  }

  requestAnimationFrame(renderAscii);

  (window as any).onYouTubeIframeAPIReady = () => {
    player = new YT.Player("yt-player", {
      events: {
        onStateChange(e: YT.OnStateChangeEvent) {
          if (e.data === YT.PlayerState.ENDED) {
            player.seekTo(32, true);
            player.playVideo();
          }
          const playing = e.data === YT.PlayerState.PLAYING;
          setPlaying(playing);
          document
            .querySelector(".video-crop")!
            .toggleAttribute("data-paused", !playing);
        },
      },
    });
  };

  btnPlay.addEventListener("click", () => {
    if (!player) return;
    if (player.getPlayerState() === YT.PlayerState.PLAYING) {
      player.pauseVideo();
    } else {
      player.playVideo();
    }
  });

  btnMute.addEventListener("click", () => {
    if (!player) return;
    if (player.isMuted()) {
      player.unMute();
      setMuted(false);
    } else {
      player.mute();
      setMuted(true);
    }
  });
</script>

<style>
  .not-found {
    text-align: left;
    padding: 4rem 0;
  }

  h1 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    font-size: 10rem;
    font-weight: 700;
    margin: 0;
    line-height: 1;
    color: white;
    pointer-events: none;
  }

  p {
    font-size: 1.1rem;
    color: black;
    margin: 1rem 0 2rem;
  }

  figure {
    margin: 0 0 2rem;
  }

  .video-crop {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .video-crop iframe {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    pointer-events: none;
  }

  .ascii-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    image-rendering: pixelated;
  }

  .video-crop::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0);
    transition:
      background 0.3s,
      backdrop-filter 0.3s;
    pointer-events: none;
  }

  .video-crop[data-paused]::after {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
  }

  .controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 4;
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  }

  .controls button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.15);
    color: white;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background 0.15s;
  }

  .controls button:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .controls svg {
    width: 18px;
    height: 18px;
  }

  /* initial: playing → show pause, hide play */
  .icon-play {
    display: none;
  }

  /* initial: muted → show muted, hide unmuted */
  .icon-unmuted {
    display: none;
  }

  nav {
    margin-top: 2rem;
    display: flex;
    gap: 0.5rem;
  }

  nav a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
