---
import Container from "@components/Container.astro";
import NotFoundPlayer from "@components/not-found/NotFoundPlayer.astro";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="404" description="페이지를 찾을 수 없습니다">
  <Container>
    <div class="not-found">
      <NotFoundPlayer />
      <p>페이지를 찾을 수 없습니다.</p>
      <nav>
        <a href="/">홈으로 돌아가기</a>
        <span>·</span>
        <a href="/blog">블로그</a>
      </nav>
    </div>
  </Container>
</PageLayout>

<style>
  .not-found {
    text-align: left;
    padding: 4rem 0;
  }

  p {
    font-size: 1.1rem;
    color: black;
    margin: 1rem 0 2rem;
  }

  nav {
    margin-top: 2rem;
    display: flex;
    gap: 0.5rem;
  }

  nav a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
