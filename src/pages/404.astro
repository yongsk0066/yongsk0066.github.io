---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="404" description="페이지를 찾을 수 없습니다">
  <Container>
    <div class="not-found">
      <figure>
        <div class="video-crop">
          <h1>404</h1>
          <iframe
            id="yt-player"
            src="https://www.youtube.com/embed/zhHB4dZTChw?start=32&autoplay=1&mute=1&controls=0&enablejsapi=1&modestbranding=1&rel=0"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            loading="lazy"
            allowfullscreen></iframe>
          <div class="controls">
            <button id="btn-play" type="button" aria-label="일시정지">
              <svg
                class="icon-pause"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="20"
                height="20"
              >
                <rect x="6" y="4" width="4" height="16"></rect>
                <rect x="14" y="4" width="4" height="16"></rect>
              </svg>
              <svg
                class="icon-play"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="20"
                height="20"
              >
                <polygon points="6,3 20,12 6,21"></polygon>
              </svg>
            </button>
            <button id="btn-mute" type="button" aria-label="음소거 해제">
              <svg
                class="icon-muted"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="20"
                height="20"
              >
                <polygon points="11,5 6,9 2,9 2,15 6,15 11,19"></polygon>
                <line
                  x1="23"
                  y1="9"
                  x2="17"
                  y2="15"
                  stroke="currentColor"
                  stroke-width="2"></line>
                <line
                  x1="17"
                  y1="9"
                  x2="23"
                  y2="15"
                  stroke="currentColor"
                  stroke-width="2"></line>
              </svg>
              <svg
                class="icon-unmuted"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="20"
                height="20"
              >
                <polygon points="11,5 6,9 2,9 2,15 6,15 11,19"></polygon>
                <path
                  d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"></path>
              </svg>
            </button>
          </div>
        </div>
      </figure>
      <p>페이지를 찾을 수 없습니다.</p>
      <nav>
        <a href="/">홈으로 돌아가기</a>
        <span>·</span>
        <a href="/blog">블로그</a>
      </nav>
    </div>
  </Container>
</PageLayout>

<script>
  const tag = document.createElement("script");
  tag.src = "https://www.youtube.com/iframe_api";
  document.head.appendChild(tag);

  let player: YT.Player;
  const btnPlay = document.getElementById("btn-play")!;
  const btnMute = document.getElementById("btn-mute")!;

  function setPlaying(playing: boolean) {
    btnPlay.querySelector<SVGElement>(".icon-pause")!.style.display = playing
      ? ""
      : "none";
    btnPlay.querySelector<SVGElement>(".icon-play")!.style.display = playing
      ? "none"
      : "";
    btnPlay.setAttribute("aria-label", playing ? "일시정지" : "재생");
  }

  function setMuted(muted: boolean) {
    btnMute.querySelector<SVGElement>(".icon-muted")!.style.display = muted
      ? ""
      : "none";
    btnMute.querySelector<SVGElement>(".icon-unmuted")!.style.display = muted
      ? "none"
      : "";
    btnMute.setAttribute("aria-label", muted ? "음소거 해제" : "음소거");
  }

  // initial state: playing + muted
  setPlaying(true);
  setMuted(true);

  (window as any).onYouTubeIframeAPIReady = () => {
    player = new YT.Player("yt-player", {
      events: {
        onStateChange(e: YT.OnStateChangeEvent) {
          if (e.data === YT.PlayerState.ENDED) {
            player.seekTo(32, true);
            player.playVideo();
          }
          const playing = e.data === YT.PlayerState.PLAYING;
          setPlaying(playing);
          document
            .querySelector(".video-crop")!
            .toggleAttribute("data-paused", !playing);
        },
      },
    });
  };

  btnPlay.addEventListener("click", () => {
    if (!player) return;
    if (player.getPlayerState() === YT.PlayerState.PLAYING) {
      player.pauseVideo();
    } else {
      player.playVideo();
    }
  });

  btnMute.addEventListener("click", () => {
    if (!player) return;
    if (player.isMuted()) {
      player.unMute();
      setMuted(false);
    } else {
      player.mute();
      setMuted(true);
    }
  });
</script>

<style>
  .not-found {
    text-align: left;
    padding: 4rem 0;
  }

  h1 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    font-size: 10rem;
    font-weight: 700;
    margin: 0;
    line-height: 1;
    color: white;
    pointer-events: none;
  }

  p {
    font-size: 1.1rem;
    color: black;
    margin: 1rem 0 2rem;
  }

  figure {
    margin: 0 0 2rem;
  }

  .video-crop {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .video-crop iframe {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    pointer-events: none;
  }

  .video-crop::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0);
    transition:
      background 0.3s,
      backdrop-filter 0.3s;
    pointer-events: none;
  }

  .video-crop[data-paused]::after {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
  }

  .controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  }

  .controls button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.15);
    color: white;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background 0.15s;
  }

  .controls button:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .controls svg {
    width: 18px;
    height: 18px;
  }

  /* initial: playing → show pause, hide play */
  .icon-play {
    display: none;
  }

  /* initial: muted → show muted, hide unmuted */
  .icon-unmuted {
    display: none;
  }

  nav {
    margin-top: 2rem;
    display: flex;
    gap: 0.5rem;
  }

  nav a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
