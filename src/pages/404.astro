---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="404" description="페이지를 찾을 수 없습니다">
  <Container>
    <div class="not-found">
      <figure>
        <div class="video-border-wrap">
          <canvas class="spectro-border"></canvas>
          <div class="video-crop">
            <h1>404</h1>
            <iframe
              id="yt-player"
              src="https://www.youtube.com/embed/zhHB4dZTChw?start=32&autoplay=1&mute=1&controls=0&enablejsapi=1&modestbranding=1&rel=0"
              title="YouTube video player"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              loading="lazy"
              allowfullscreen></iframe>
            <canvas class="ascii-overlay" width="2250" height="1500"></canvas>
            <div class="controls">
              <button id="btn-play" type="button" aria-label="일시정지">
                <svg
                  class="icon-pause"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  width="20"
                  height="20"
                >
                  <rect x="6" y="4" width="4" height="16"></rect>
                  <rect x="14" y="4" width="4" height="16"></rect>
                </svg>
                <svg
                  class="icon-play"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  width="20"
                  height="20"
                >
                  <polygon points="6,3 20,12 6,21"></polygon>
                </svg>
              </button>
              <button id="btn-mute" type="button" aria-label="음소거 해제">
                <svg
                  class="icon-muted"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  width="20"
                  height="20"
                >
                  <polygon points="11,5 6,9 2,9 2,15 6,15 11,19"></polygon>
                  <line
                    x1="23"
                    y1="9"
                    x2="17"
                    y2="15"
                    stroke="currentColor"
                    stroke-width="2"></line>
                  <line
                    x1="17"
                    y1="9"
                    x2="23"
                    y2="15"
                    stroke="currentColor"
                    stroke-width="2"></line>
                </svg>
                <svg
                  class="icon-unmuted"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  width="20"
                  height="20"
                >
                  <polygon points="11,5 6,9 2,9 2,15 6,15 11,19"></polygon>
                  <path
                    d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"></path>
                </svg>
              </button>
              <button id="btn-mode" type="button" aria-label="효과: ASCII">
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  width="20"
                  height="20"
                >
                  <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                  <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                  <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                  <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </figure>
      <p>페이지를 찾을 수 없습니다.</p>
      <nav>
        <a href="/">홈으로 돌아가기</a>
        <span>·</span>
        <a href="/blog">블로그</a>
      </nav>
    </div>
  </Container>
</PageLayout>

<script>
  import { createOverlayRenderer } from "@lib/not-found/overlay-renderer";
  import { createSpectroBorderRenderer } from "@lib/not-found/spectro-border";

  // ---- YouTube API ----
  const tag = document.createElement("script");
  tag.src = "https://www.youtube.com/iframe_api";
  document.head.appendChild(tag);

  const VIDEO_START = 32;
  let player: YT.Player;

  // ---- UI elements ----
  const btnPlay = document.getElementById("btn-play")!;
  const btnMute = document.getElementById("btn-mute")!;
  const btnMode = document.getElementById("btn-mode")!;

  function setPlaying(playing: boolean) {
    btnPlay.querySelector<SVGElement>(".icon-pause")!.style.display = playing
      ? ""
      : "none";
    btnPlay.querySelector<SVGElement>(".icon-play")!.style.display = playing
      ? "none"
      : "";
    btnPlay.setAttribute("aria-label", playing ? "일시정지" : "재생");
  }

  function setMuted(muted: boolean) {
    btnMute.querySelector<SVGElement>(".icon-muted")!.style.display = muted
      ? ""
      : "none";
    btnMute.querySelector<SVGElement>(".icon-unmuted")!.style.display = muted
      ? "none"
      : "";
    btnMute.setAttribute("aria-label", muted ? "음소거 해제" : "음소거");
  }

  setPlaying(true);
  setMuted(true);

  // ---- Overlay renderer ----
  const renderer = createOverlayRenderer(
    document.querySelector<HTMLCanvasElement>(".ascii-overlay")!,
    () => {
      try {
        return Math.max(0, player.getCurrentTime() - VIDEO_START);
      } catch {
        return null;
      }
    },
    (name) => btnMode.setAttribute("aria-label", `효과: ${name}`),
  );
  renderer.start();

  // ---- YouTube Player ----
  (window as any).onYouTubeIframeAPIReady = () => {
    player = new YT.Player("yt-player", {
      events: {
        onStateChange(e: YT.OnStateChangeEvent) {
          if (e.data === YT.PlayerState.ENDED) {
            player.seekTo(32, true);
            player.playVideo();
          }
          setPlaying(e.data === YT.PlayerState.PLAYING);
        },
      },
    });
  };

  // ---- Controls ----
  btnPlay.addEventListener("click", () => {
    if (!player) return;
    if (player.getPlayerState() === YT.PlayerState.PLAYING) {
      player.pauseVideo();
    } else {
      player.playVideo();
    }
  });

  btnMute.addEventListener("click", () => {
    if (!player) return;
    if (player.isMuted()) {
      player.unMute();
      setMuted(false);
    } else {
      player.mute();
      setMuted(true);
    }
  });

  btnMode.addEventListener("click", () => renderer.toggleAutoMode());

  // ---- Audio Spectrogram Border ----
  const TRACK_WIDTH = 48; // CSS pixels
  const borderCanvas = document.querySelector<HTMLCanvasElement>(
    ".spectro-border",
  )!;
  const wrap = document.querySelector<HTMLElement>(".video-border-wrap")!;
  const dpr = Math.min(window.devicePixelRatio, 2);
  const wrapRect = wrap.getBoundingClientRect();
  borderCanvas.width = Math.round(wrapRect.width * dpr);
  borderCanvas.height = Math.round(wrapRect.height * dpr);

  const spectroRenderer = createSpectroBorderRenderer(
    borderCanvas,
    TRACK_WIDTH,
  );

  let spectroData: {
    binsPerFrame: number;
    fps: number;
    frameCount: number;
    frames: Uint8Array;
  } | null = null;

  fetch("/assets/404-audio.bin")
    .then((r) => r.arrayBuffer())
    .then((buf) => {
      const v = new DataView(buf);
      spectroData = {
        binsPerFrame: v.getUint16(0, true),
        fps: v.getUint16(2, true),
        frameCount: v.getUint16(4, true),
        frames: new Uint8Array(buf, 6),
      };
    });

  let lastVizFrame = -1;

  function renderViz() {
    requestAnimationFrame(renderViz);
    if (!spectroData || !player) return;

    let clipTime: number;
    try {
      clipTime = Math.max(0, player.getCurrentTime() - VIDEO_START);
    } catch {
      return;
    }

    const frameIdx =
      Math.floor(clipTime * spectroData.fps) % spectroData.frameCount;
    if (frameIdx === lastVizFrame) return;
    lastVizFrame = frameIdx;

    spectroRenderer.pushColumn(
      spectroData.frames,
      frameIdx * spectroData.binsPerFrame,
      spectroData.binsPerFrame,
      clipTime,
    );
  }

  requestAnimationFrame(renderViz);
</script>

<style>
  .not-found {
    text-align: left;
    padding: 4rem 0;
  }

  h1 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    font-size: 10rem;
    font-weight: 700;
    margin: 0;
    line-height: 1;
    color: white;
    pointer-events: none;
  }

  p {
    font-size: 1.1rem;
    color: black;
    margin: 1rem 0 2rem;
  }

  figure {
    margin: 0 0 2rem;
  }

  .video-border-wrap {
    position: relative;
    padding: 48px;
    margin: -48px -48px 0;
    visibility: hidden;
  }

  .video-border-wrap > .video-crop {
    visibility: visible;
  }

  .spectro-border {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .video-crop {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .video-crop iframe {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    pointer-events: none;
  }

  .ascii-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    image-rendering: pixelated;
  }

  .controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  }

  .controls button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.15);
    color: white;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background 0.15s;
  }

  .controls button:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .controls svg {
    width: 18px;
    height: 18px;
  }

  /* initial: playing → show pause, hide play */
  .icon-play {
    display: none;
  }

  /* initial: muted → show muted, hide unmuted */
  .icon-unmuted {
    display: none;
  }

  nav {
    margin-top: 2rem;
    display: flex;
    gap: 0.5rem;
  }

  nav a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
