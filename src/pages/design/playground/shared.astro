---
import SharedPlayground from "../../../components/article/reploom/SharedPlayground";
import manifest from "../../../../public/reploom/manifest.json";
const projects = Object.fromEntries(
  Object.entries(manifest.projects).map(([id, p]) => [id, p.title])
);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>공유 예제</title>
  </head>
  <body>
    <main>
      <SharedPlayground projects={projects} client:load />
    </main>
  </body>
</html>
<style>
  body {
    margin: 0;
    font:
      1rem/1.5 system-ui,
      sans-serif;
  }
  main {
    max-inline-size: 64rem;
    margin-inline: auto;
    padding: clamp(0.75rem, 3vw, 2rem);
  }
  main :global(h1) {
    margin-block: 0.75rem;
    font-size: 1.25rem;
  }
  main :global(a) {
    color: inherit;
  }
</style>
