---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SOCIALS } from "@consts";
import PageLayout from "@layouts/PageLayout.astro";
import { dateRange } from "@lib/utils";
---

<style>
  video {
    aspect-ratio: 4 / 3;
    width: fit-content;
    border-radius: 0.5rem;
    overflow: hidden;
    object-fit: cover;
    box-sizing: border-box;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    outline: 0.5rem solid black;
    width: calc(100% - 1rem);
    height: calc(100% - 1rem);
    background-color: black;
    margin: 0 auto;
    position: relative;
  }

  figure {
    margin: 2rem auto;
    display: grid;
    place-items: center;
  }

  .addition {
    color: #3fb950;
  }

  .deletion {
    color: #f85149;
  }
</style>
<PageLayout title={"About Me"} description={"나는 누구인가?"}>
  <Container>
    <figure>
      <video
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        oncontextmenu="return false;"
      >
        <source src="https://static.yongseok.me/about.mp4" type="video/mp4" />
      </video>
      <figcaption class="mt-2 text-sm text-gray-500">
        My footage from 2024, shot on super8 film
      </figcaption>
    </figure>
    <div class="space-y-16">
      <h1 class="antialiased text-3xl font-bold leading-[1.4] text-black mb-4">
        Hi! 👋<br /> My name is YongSeok Jang <br /> and I am a frontend engineer.
        <br />
        <br />
        Based in Seoul, South Korea. 🇰🇷
      </h1>
      <a
        href="https://duolingo.com/profile/yongsk0066"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-fit transition-transform hover:translate-y-1.5 rounded-xl overflow-hidden mb-4"
      >
        <img
          src="https://yongsk0066.github.io/duolingo-card/card.svg"
          alt="My Duolingo Stats"
          loading="lazy"
          width="420"
          height="185"
          class="block"
          style={{ margin: "0 !important" }}
        />
      </a>
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black">Work Experience</h5>
        </div>
        <ul class="flex flex-col space-y-4">
          <li class="animate">
            <div class="text-sm opacity-75">
              {dateRange(new Date("2026-01"))}
            </div>
            <div class="font-semibold text-black">
              <a
                href="https://www.naverfincorp.com/"
                target="_blank"
                rel="noopener noreferrer">NAVER FINANCIAL</a
              >
            </div>
            <div class="text-sm opacity-75">Frontend Engineer</div>
          </li>
          <li class="animate">
            <div class="text-sm opacity-75">
              {dateRange(new Date("2025-08"), new Date("2025-12"))}
            </div>
            <div class="font-semibold text-black">
              <a
                href="https://corp.remember.co.kr"
                target="_blank"
                rel="noopener noreferrer">리멤버앤컴퍼니(Remember&Company)</a
              >
            </div>
            <div class="text-sm opacity-75">Web Frontend Tech Lead</div>
          </li>
          <li class="animate">
            <div class="text-sm opacity-75">
              {dateRange(new Date("2021-06"), new Date("2025-08"))}
            </div>
            <div class="font-semibold text-black">
              <a
                href="https://corp.remember.co.kr"
                target="_blank"
                rel="noopener noreferrer">리멤버앤컴퍼니(Remember&Company)</a
              >
            </div>
            <div class="text-sm opacity-75">Frontend Engineer</div>
          </li>
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black">Education</h5>
        </div>
        <ul class="flex flex-col space-y-4">
          <li class="animate">
            <div class="text-sm opacity-75">
              {dateRange(new Date("2015-02"), new Date("2022-02"))}
            </div>
            <div class="font-semibold text-black">
              Dongguk University (동국대학교)
            </div>
            <div class="text-sm opacity-75">
              <a
                href="https://cse.dongguk.edu/main"
                target="_blank"
                rel="noopener noreferrer"
              >
                Computer Science & Engineering</a
              >, <a
                href="https://food.dongguk.edu/main"
                target="_blank"
                rel="noopener noreferrer">Food Science & Biotechnology</a
              >
            </div>
          </li>
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black">OSS Contributions</h5>
        </div>
        <ul class="flex flex-col space-y-4">
          <li class="animate">
            <div class="text-sm opacity-75">April 2025</div>
            <div class="font-semibold text-black">
              <a
                href="https://github.com/facebook/react/pull/32614"
                target="_blank"
                rel="noopener noreferrer"
              >
                React DevTools <span class="text-gray-400">[link]</span>
              </a>
            </div>
            <div class="text-sm opacity-75">
              • PR #32614 (<span class="addition">+124</span>/<span
                class="deletion">−3</span
              > LOC, merged)
              <br />
              • Re-implemented Trace Updates overlay with the Popover API, making
              update highlights visible even over &lt;dialog&gt;/&lt;popover&gt;.
            </div>
          </li>
          <li class="animate">
            <div class="text-sm opacity-75">April 2025</div>
            <div class="font-semibold text-black">
              <a
                href="https://github.com/facebook/react/pull/32703"
                target="_blank"
                rel="noopener noreferrer"
              >
                React DevTools <span class="text-gray-400">[link]</span>
              </a>
            </div>
            <div class="text-sm opacity-75">
              • PR #32703 (<span class="addition">+23</span>/<span
                class="deletion">−3</span
              > LOC, under review)
              <br />
              • Migrated Component Inspector overlay to the same Popover-based top-layer,
              unifying all DevTools overlays and fixing similar visibility issues.
            </div>
          </li>
          <li class="animate">
            <div class="text-sm opacity-75">March 2025</div>
            <div class="font-semibold text-black">
              <a
                href="https://github.com/flow-typed/flow-typed/pull/4607"
                target="_blank"
                rel="noopener noreferrer"
              >
                flow-typed <span class="text-gray-400">[link]</span>
              </a>
            </div>
            <div class="text-sm opacity-75">
              • PR #4607 merged: Added full DOM typings & tests for the new
              Popover API (+95 LOC).
              <br />
              • Enables Flow users to adopt &lt;popover&gt; and ToggleEvent with static-type
              safety across all supported Flow versions.
            </div>
          </li>
          <li class="animate">
            <div class="text-sm opacity-75">September 2025</div>
            <div class="font-semibold text-black">
              <a
                href="https://github.com/oxc-project/oxc/pull/13604"
                target="_blank"
                rel="noopener noreferrer"
              >
                oxc (JavaScript toolchain) <span class="text-gray-400"
                  >[link]</span
                >
              </a>
            </div>
            <div class="text-sm opacity-75">
              • PR #13604 (<span class="addition">+28</span>/<span
                class="deletion">−3</span
              > LOC, merged)
              <br />
              • Fixed Language Server diagnostics disappearing on save when typeAware
              is disabled with onType linting mode.
            </div>
          </li>
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black">Presentations</h5>
        </div>
        <div class="space-y-4">
          <figure class="w-full flex flex-col my-4">
            <div
              class="w-full block aspect-video border-0 bg-black rounded-lg shadow-[0px_0px_12px_6px_rgba(0,0,0,0.36)] overflow-hidden m-0"
            >
              <iframe
                class="w-full aspect-video border-0"
                src="https://www.youtube.com/embed/zrAGRppDkSw"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                loading="lazy"
                allowfullscreen></iframe>
            </div>
          </figure>
        </div>
      </section>

      <section class="animate space-y-6">
        <h5 class="font-semibold text-black">YouTube Channel</h5>
        <div class="space-y-4">
          <div class="text-sm opacity-75 mb-4">
            My YouTube channel featuring personal videos and projects
          </div>
          <figure class="w-full flex flex-col my-4">
            <div
              class="w-full block aspect-video border-0 bg-black rounded-lg shadow-[0px_0px_12px_6px_rgba(0,0,0,0.36)] overflow-hidden m-0"
            >
              <iframe
                class="w-full aspect-video border-0"
                src="https://www.youtube.com/embed/MGG7qDSgOBQ?si=XO1p0YSEpcuvPat_"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                loading="lazy"
                allowfullscreen></iframe>
            </div>
          </figure>
          <div class="mt-2 text-sm text-gray-500">
            My latest videos from <a
              href="https://www.youtube.com/@%EB%8F%84%EB%A3%A1-h8i"
              target="_blank"
              rel="noopener noreferrer"
              class="underline">my YouTube channel</a
            >
          </div>
        </div>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black">Let's Connect</h5>
        <article>
          <p>
            If you want to get in touch with me about something or just to say
            hi, reach out on social media.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {
            SOCIALS.map((SOCIAL) => (
              <li class="flex gap-x-2 text-nowrap">
                <Link href={SOCIAL.HREF} external>
                  {SOCIAL.NAME}
                </Link>
                {"/"}
              </li>
            ))
          }
          <li>What should I add next?</li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
