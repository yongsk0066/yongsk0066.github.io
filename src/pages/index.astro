---
import PageLayout from "@layouts/PageLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<script>
  import "../components/lit/ascii-screen/home-cover-element";
</script>

<style>
    :global(main) {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 100%;
    }
</style>

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
      <h1 class="sr-only">{SITE_TITLE}</h1>
      <div class="mx-auto animate-expand px-8 max-sm:px-4 max-sm:-mt-8">
        <home-cover-element></home-cover-element>
      </div>
</PageLayout>
