---
import PageLayout from "@layouts/PageLayout.astro";
import BaseHead from "@components/head/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<html lang="ko">
  <script>
    import "../components/lit/ascii-screen/home-cover-element";
  </script>

  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <style>
    main {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 100%;
    }
  </style>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5MPJHHS7"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <!-- <Header title={SITE_TITLE} /> -->
    <PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
      <div class="mx-auto animate-expand px-8 max-sm:px-4 max-sm:-mt-8">
        <home-cover-element></home-cover-element>
      </div>
    </PageLayout>
  </body>
</html>
