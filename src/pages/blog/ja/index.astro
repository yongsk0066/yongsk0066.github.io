---
import ArrowCard from "@components/blog/ArrowCard.astro";
import BlogSidebar from "@components/blog/BlogSidebar.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { type CollectionEntry, getCollection } from "astro:content";

const data = (await getCollection("blog"))
  .filter((post) => {
    if (post.id.includes("/") && !post.id.startsWith("ja/")) return false;
    return import.meta.env.DEV || !post.data.draft;
  })
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .filter((post, index, self) => {
    const hasJaVersion = self.some((p) => p.id === `ja/${post.id}`);
    if (hasJaVersion && !post.id.startsWith("ja/")) {
      return false;
    }
    return true;
  });

// Categories with counts
const categoryMap = new Map<string, number>();
data.forEach((post) => {
  post.data.categories?.forEach((cat) => {
    categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
  });
});
const categories = [...categoryMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

// Series with post lists (2+ posts only)
const seriesMap = new Map<string, typeof data>();
data.forEach((post) => {
  if (post.data.series) {
    if (!seriesMap.has(post.data.series)) {
      seriesMap.set(post.data.series, []);
    }
    seriesMap.get(post.data.series)!.push(post);
  }
});
const series = [...seriesMap.entries()]
  .filter(([, posts]) => posts.length > 1)
  .map(([name, posts]) => ({
    name,
    posts: posts
      .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
      .map((p) => ({ title: p.data.title, href: `/${p.collection}/${p.id}/` })),
  }));

type Acc = {
  [year: string]: CollectionEntry<"blog">[];
};

const posts = data.reduce((acc: Acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title="ヨンソクのブログ" description="開発、技術、そして日常のブログです。"
  webmcpPageType="blog-list" webmcpCurrentLocale="ja">
  <div class="mx-auto max-w-2xl px-5">
    <div class="space-y-10">
      <div class="animate font-semibold text-black">ブログ</div>
      <BlogSidebar categories={categories} series={series} locale="ja" />
      <div class="space-y-4">
        {
          years.map((year) => (
            <section class="animate space-y-4" data-year={year}>
              <div class="font-semibold text-black">{year}</div>
              <div>
                <ul class="flex flex-col gap-4">
                  {posts[year].map((post) => (
                    <li data-categories={JSON.stringify(post.data.categories || [])}>
                      <ArrowCard entry={post} />
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</PageLayout>
