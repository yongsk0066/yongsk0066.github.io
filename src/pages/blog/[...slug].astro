---
import { createHash } from "node:crypto";
import ArticleProse from "@components/blog/ArticleProse.astro";
import BackToPrev from "@components/blog/BackToPrev.astro";
import Comments from "@components/blog/Comments.astro";
import Container from "@components/layout/Container.astro";
import FormattedDate from "@components/blog/FormattedDate.astro";
import PostNavigation from "@components/blog/PostNavigation.astro";
import CopyMenu from "@components/blog/CopyMenu.astro";
import Share from "@components/blog/Share.astro";
import TOC from "@components/blog/TOC.astro";
import { ImageLightbox } from "@components/ImageLightbox";
import { DEFAULT_LOCALE, OTHER_LOCALES } from "@consts";
import { useTranslations } from "@i18n/utils";
import PageLayout from "@layouts/PageLayout.astro";
import { readingTime } from "@lib/blog";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const _locales = ["en", "ja"];
  const _getLocale = (id: string) => _locales.find((l) => id.startsWith(`${l}/`)) || "ko";

  const allPosts = (await getCollection("blog"))
    .filter((post) => import.meta.env.DEV || !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  const collectionCacheKey = createHash("sha256").update(allPosts.map((p) => `${p.id}:${p.digest}`).join("|" )).digest("hex");

  return allPosts.map((post) => {
    const postLocale = _getLocale(post.id);
    const sameLangPosts = allPosts.filter((p) => _getLocale(p.id) === postLocale);
    const langIndex = sameLangPosts.findIndex((p) => p.id === post.id);

    const prevPost = langIndex < sameLangPosts.length - 1
      ? { slug: sameLangPosts[langIndex + 1].id, title: sameLangPosts[langIndex + 1].data.title }
      : undefined;
    const nextPost = langIndex > 0
      ? { slug: sameLangPosts[langIndex - 1].id, title: sameLangPosts[langIndex - 1].data.title }
      : undefined;

    return {
      params: { slug: post.id },
      props: { post, prevPost, nextPost },
      // Navigation and translations depend on the entire published collection.
      cacheKey: `${post.id}:${collectionCacheKey}`,
    };
  });
}
type NavPost = { slug: string; title: string };
type Props = { post: CollectionEntry<"blog">; prevPost?: NavPost; nextPost?: NavPost };

const { post, prevPost, nextPost } = Astro.props;
const currentLocale = OTHER_LOCALES.find((l) => post.id.startsWith(`${l}/`)) || DEFAULT_LOCALE;

const seriesPosts = (
  await getCollection("blog", ({ id, data }) => {
    if (!import.meta.env.DEV && data.draft) return false;
    if (currentLocale === DEFAULT_LOCALE) {
      return !id.includes("/");
    }
    return id.startsWith(currentLocale);
  })
)
  .filter(
    (_post) => _post.data.series === post.data.series && !!post.data.series
  )
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

let hasTranslation = false;
let translationSlug = "";

const allPosts = (await getCollection("blog")).filter((p) => import.meta.env.DEV || !p.data.draft);

if (currentLocale === DEFAULT_LOCALE) {
  translationSlug = `en/${post.id}`;
  hasTranslation = allPosts.some((p) => p.id === translationSlug);
} else {
  const baseSlug = post.id.replace(new RegExp(`^${currentLocale}/`), "");
  translationSlug = baseSlug;
  hasTranslation = allPosts.some((p) => p.id === translationSlug);
}

// Compute available locales for language switcher UI
const availableLocales: string[] = [currentLocale];
const _baseSlug = currentLocale === DEFAULT_LOCALE
  ? post.id
  : post.id.replace(new RegExp(`^${currentLocale}/`), "");

if (currentLocale !== DEFAULT_LOCALE) {
  if (allPosts.some((p) => p.id === _baseSlug)) availableLocales.push(DEFAULT_LOCALE);
}
for (const locale of OTHER_LOCALES) {
  if (locale === currentLocale) continue;
  if (allPosts.some((p) => p.id === `${locale}/${_baseSlug}`)) availableLocales.push(locale);
}

const { Content, headings } = await render(post);
const t = useTranslations(currentLocale as any);
---

<script>
  const elementModules = [
    ["thumbnail-element", () => import("../../components/thumbnail-element")],
    ["youtube-element", () => import("../../components/lit/youtube-element")],
    ["mermaid-diagram", () => import("../../components/mermaid/mermaid-element")],
  ] as const;

  for (const [selector, load] of elementModules) {
    if (document.querySelector(selector)) void load();
  }
</script>

<PageLayout
  title={post.data.title}
  description={post.data.description ?? ""}
  heroImage={post.data.heroImage}
  webmcpPageType="blog-post"
  webmcpHasTranslation={hasTranslation}
  webmcpTranslationSlug={translationSlug}
  webmcpCurrentLocale={currentLocale}
  availableLocales={availableLocales}
  article={{ date: post.data.date, updatedDate: post.data.updatedDate, categories: post.data.categories }}
  noindex={!!post.data.draft}
>
  <Container>
    <div>
      <BackToPrev href={t("path.blog")}>
        {t("page.back")}
      </BackToPrev>
    </div>
    <!-- series -->
    <div class="flex items-center gap-1.5"></div>
    <div class="space-y-1 my-10" id="post-meta">
      <div class="flex items-center gap-1.5 justify-between">
        <div class="flex items-center gap-1.5">
          <div class="font-base text-sm">
            <a href="/about/" rel="author">장용석</a> &bull;
            <FormattedDate date={post.data.date} />
          </div>
          &bull;
          <div class="font-base text-sm">
            {readingTime(post.body ?? "")}
          </div>
        </div>
        <CopyMenu id="post-meta" />
      </div>

      <h1 class="text-3xl font-bold text-black break-keep">
        {post.data.title}
      </h1>
      {
        seriesPosts.length > 1 && (
          <div class="text-zinc-500">
            <div class="text-base mt-8 text-zinc-600 text-bold">
              [ {post.data.series} ] {t("word.series")}
            </div>
            <ul class="flex flex-col gap-y-2.5 my-3 border-l-2 border-zinc-300">
              {seriesPosts.map((seriesPost) => {
                const link = `/${seriesPost.collection}/${seriesPost.id}`;
                return (
                  <li class="text-sm indent-2 underline hover:text-zinc-800">
                    <a href={link} rel="noopener noreferrer" target="_blank">
                      {seriesPost.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }
    </div>
    <!-- Table of Contents -->
    <TOC headings={headings} />
    <ArticleProse>
      <Content />
    </ArticleProse>
    <ImageLightbox client:load />
    {
      seriesPosts.length > 1 && (
        <div class="animate text-zinc-500">
          <div class="text-base mt-8 text-zinc-600 text-bold">
            [ {post.data.series} ] {t("word.series")}
          </div>
          <ul class="flex flex-col gap-y-2.5 my-3 border-l-2 border-zinc-300">
            {seriesPosts.map((seriesPost) => {
              const link = `/${seriesPost.collection}/${seriesPost.id}`;
              return (
                <li class="text-sm indent-2 underline hover:text-zinc-800">
                  <a href={link}>{seriesPost.data.title}</a>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
    <div class="mx-auto my-4 flex gap-2 justify-center">
      <CopyMenu id="post-footer" />
      <Share />
    </div>
    <PostNavigation prevPost={prevPost} nextPost={nextPost} />
    <Comments />
  </Container>
</PageLayout>
