---
import PageLayout from "../../layouts/PageLayout.astro";
import Container from "../../components/layout/Container.astro";
import Gallery from "./Gallery";
import { galleryProjects } from "../../playground/projects.mjs";
---

<PageLayout
  title="브라우저 코드 실험실"
  description="React·DOM·Worker 예제를 브라우저에서 실행하고 편집해 보세요."
  noindex
>
  <main>
    <Container>
      <a href="/blog/useeffectevent/">← 원래 글 읽기</a>
      <h1>브라우저 코드 실험실</h1>
      <p class="introduction">
        예제를 선택하고 코드를 수정해 결과를 비교해 보세요.
      </p>
      <Gallery projects={galleryProjects} client:load />
    </Container>
  </main>
</PageLayout>
<style>
  h1 {
    margin-block: 1.5rem 0.5rem;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .introduction {
    margin-block: 0 1.5rem;
    color: #52525b;
    font-size: 0.875rem;
  }
  a {
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
</style>
