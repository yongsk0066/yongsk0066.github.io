---
import Head from "@components/head/Head.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import WebMCP from "@components/layout/WebMCP.astro";
import ClarityIdentify from "@components/head/ClarityIdentify.astro";
import { SITE_TITLE } from "@consts";

type Props = {
  title: string;
  description: string;
  heroImage?: string;
  webmcpPageType?: "blog-post" | "blog-list" | "other";
  webmcpHasTranslation?: boolean;
  webmcpTranslationSlug?: string;
  webmcpCurrentLocale?: string;
};

const {
  title,
  description,
  heroImage,
  webmcpPageType = "other",
  webmcpHasTranslation = false,
  webmcpTranslationSlug = "",
  webmcpCurrentLocale = Astro.currentLocale,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={`${title} | ${SITE_TITLE}`}
      description={description}
      image={heroImage}
    />
    <ClarityIdentify pageId={Astro.url.pathname} />

    <!-- 웹사이트 구조화된 데이터 -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "장용석 블로그",
        "alternateName": "Yongseok's Blog",
        "url": "https://yongseok.me",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://yongseok.me/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>

    <!-- 조직 구조화된 데이터 -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Yongseok Jang",
        "url": "https://yongseok.me",
        "logo": "https://yongseok.me/favicon-light.svg",
        "sameAs": [
          "https://x.com/yongsk0066",
          "https://github.com/yongsk0066",
          "https://www.linkedin.com/in/yongseok-jang-129267181/"
        ]
      }
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WebMCP
      pageType={webmcpPageType}
      hasTranslation={webmcpHasTranslation}
      translationSlug={webmcpTranslationSlug}
      currentLocale={webmcpCurrentLocale}
    />
  </body>
</html>
