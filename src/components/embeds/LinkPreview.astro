---
// link preview component
interface Props {
  src: string;
  title?: string;
  description?: string;
  imagePosition?: CSSProperties["objectPosition"];
}
import { getLinkPreview } from "../../lib/link-previews.mjs";
import type { CSSProperties } from "react";
const {
  src,
  title: _title,
  description: _description,
  imagePosition = "center",
} = Astro.props;

const card = await getLinkPreview(src);
const title = _title || card.title || src;
const description = _description || card.description || "No description available";
const image = card.image;
---

<a
  class="link-preview group/item not-prose
  bg-white text-black/50
  border border-black/15
  overflow-hidden max-h-40 mb-4
  transition-colors duration-200 ease-in-out
  hover:border-black/50"
  href={src}
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="p-4 h-auto box-border">
    <h3
      class="!m-0 !text-base !font-semibold !text-black line-clamp-2 whitespace-normal break-all"
    >
      {title}
    </h3>
    <p
      class="!m-0 !mt-2 !text-black/50
    !text-sm line-clamp-2 whitespace-normal break-all"
    >
      {description}
    </p>
    <span class="!text-xs !text-black/40 line-clamp-1">{src}</span>
  </div>
  {
    image && (
      <div class="overflow-hidden flex items-center">
        <img
          class="h-full max-h-40 w-full object-center m-0
        link-preview__image"
          src={image}
          alt={title}
          style={{ objectPosition: imagePosition, objectFit: "cover" }}
        />
      </div>
    )
  }
</a>
<style>
  .link-preview {
    display: grid;
    grid-template-columns: 70% auto;
    text-decoration: none;
    column-gap: 1em;
  }
  .link-preview:not(:has(img)) {
    grid-template-columns: 1fr;
  }
  .link-preview__image {
    border-radius: 0% !important;
  }
</style>
