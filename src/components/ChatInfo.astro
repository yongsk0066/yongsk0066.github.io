---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`chat-info ${className}`}>
  <slot />
</div>

<style>
  .chat-info {
    text-align: center;
    margin: 0.75rem 0;
    font-size: 0.875rem;
    color: #6b7280;
    font-style: italic;
  }
</style>
