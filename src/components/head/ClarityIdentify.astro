---
/**
 * Microsoft Clarity 사용자 식별 컴포넌트
 * 페이지 레이아웃에 포함하여 사용자 식별 가능
 */

interface Props {
  userId?: string;
  pageId?: string;
  friendlyName?: string;
}

const { userId, pageId = Astro.url.pathname, friendlyName } = Astro.props;
const isProduction = import.meta.env.PROD;
---

<script is:inline define:vars={{ userId, pageId, friendlyName, isProduction }}>
  // 명시적인 사용자 ID가 있을 때만 프로덕션에서 식별한다.
  // 익명 방문자는 Clarity의 기본 익명 세션 추적을 사용한다.
  if (
    typeof window !== "undefined" &&
    window.clarity &&
    isProduction &&
    userId
  ) {
    // 페이지 로드 시 사용자 식별
    window.clarity(
      "identify",
      userId,
      undefined,
      pageId,
      friendlyName
    );

    // SPA 페이지 전환 시에도 사용자 식별
    document.addEventListener("astro:page-load", () => {
      if (window.clarity) {
        window.clarity(
          "identify",
          userId,
          undefined,
          location.pathname,
          friendlyName
        );
      }
    });
  }
</script>
