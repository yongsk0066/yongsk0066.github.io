---
/**
 * Microsoft Clarity 사용자 식별 컴포넌트
 * 페이지 레이아웃에 포함하여 사용자 식별 가능
 */

interface Props {
  userId?: string;
  pageId?: string;
  friendlyName?: string;
}

const { userId, pageId = Astro.url.pathname, friendlyName } = Astro.props;

const generatedUserId =
  userId || `anonymous-${Math.random().toString(36).substring(2, 15)}`;
---

<script define:vars={{ generatedUserId, pageId, friendlyName, isProd: import.meta.env.PROD }}>
  // 브라우저에서만 실행 및 프로덕션 환경에서만 실행
  if (typeof window !== "undefined" && window.clarity && isProd) {
    // 페이지 로드 시 사용자 식별
    window.clarity(
      "identify",
      generatedUserId,
      undefined,
      pageId,
      friendlyName
    );

    // SPA 페이지 전환 시에도 사용자 식별
    document.addEventListener("astro:page-load", () => {
      if (window.clarity) {
        window.clarity(
          "identify",
          generatedUserId,
          undefined,
          location.pathname,
          friendlyName
        );
      }
    });
  }
</script>
