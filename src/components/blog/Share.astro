---
import { DEFAULT_LOCALE } from "@consts";
import { useTranslations } from "@i18n/utils";

const currentLocale = Astro.currentLocale || DEFAULT_LOCALE;
const t = useTranslations(currentLocale as any);
---

<button
  id="share-button"
  class="relative group w-fit flex pl-8 pr-3 py-1.5 flex-nowrap rounded border border-black/15 hover:bg-black/5 hover:text-black transition-colors duration-300 ease-in-out"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute top-1/2 left-2 -translate-y-1/2 size-4 stroke-2 fill-none stroke-current
  group-hover:rotate-180 transition-transform duration-300 ease-in-out"
  >
    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
    ></path>
    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
    ></path>
  </svg>
  <div class="text-sm">{t("word.share")}</div>
</button>

<!-- RSS button with language dropdown -->
<div class="rss-wrapper">
  <button
    id="rss-trigger"
    popovertarget="rss-menu"
    class="relative group w-fit flex pl-8 pr-3 py-1.5 flex-nowrap rounded border border-black/15 hover:bg-black/5 hover:text-black transition-colors duration-300 ease-in-out"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="absolute top-1/2 left-2 -translate-y-1/2 size-4 fill-current"
    >
      <path
        d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
      ></path>
      <path d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
      ></path>
      <circle cx="6" cy="18" r="2"></circle>
    </svg>
    <div class="text-sm">{t("word.rss_subscribe")}</div>
  </button>

  <div id="rss-menu" popover class="rss-panel">
    <a href="/rss.xml" target="_blank" class="rss-item">
      <span class="rss-lang">KO</span>
      <span>한국어</span>
    </a>
    <a href="/en/rss.xml" target="_blank" class="rss-item">
      <span class="rss-lang">EN</span>
      <span>English</span>
    </a>
    <a href="/ja/rss.xml" target="_blank" class="rss-item">
      <span class="rss-lang">JA</span>
      <span>日本語</span>
    </a>
  </div>
</div>

<style>
  .rss-wrapper {
    position: relative;
  }

  .rss-panel {
    margin: 0;
    padding: 0.25rem;
    border: 1px solid rgb(0 0 0 / 0.15);
    border-radius: 0.375rem;
    background: white;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    min-width: 8rem;

    position: absolute;
    position-anchor: --rss-trigger;
    position-area: block-start span-inline-end;
    margin-bottom: 0.25rem;
    position-try-fallbacks: flip-block;

    opacity: 0;
    transform: scale(0.95) translateY(4px);
    transition:
      opacity 150ms ease-out,
      transform 150ms ease-out,
      display 150ms allow-discrete,
      overlay 150ms allow-discrete;
  }

  .rss-panel:popover-open {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  @starting-style {
    .rss-panel:popover-open {
      opacity: 0;
      transform: scale(0.95) translateY(4px);
    }
  }

  #rss-trigger {
    anchor-name: --rss-trigger;
  }

  .rss-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.375rem 0.5rem;
    border-radius: 0.25rem;
    color: rgb(82 82 91);
    font-size: 0.8125rem;
    line-height: 1.25rem;
    text-decoration: none;
    white-space: nowrap;
    transition: all 150ms ease-in-out;
  }

  .rss-item:hover {
    background: rgb(0 0 0 / 0.05);
    color: rgb(0 0 0);
  }

  .rss-lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    color: rgb(113 113 122);
    flex-shrink: 0;
  }

  @supports not (anchor-name: --test) {
    .rss-panel {
      position: absolute;
      bottom: 100%;
      left: 0;
      margin-bottom: 0.25rem;
    }
  }
</style>
